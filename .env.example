#
# WANDCOM — environment configuration
# Copy this file to `.env.local` and fill in the values you need.
# Everything here is OPTIONAL: the site runs without any env vars set.
#

# ---------------------------------------------------------------- public ----

# Canonical URL used for metadata, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://wandcom.co.ke

# WhatsApp number in international format, digits only (no +, no spaces).
NEXT_PUBLIC_WHATSAPP_NUMBER=254700000000

# Public contact details shown in the footer / contact page.
NEXT_PUBLIC_CONTACT_EMAIL=hello@wandcom.co.ke
NEXT_PUBLIC_CONTACT_PHONE=+254 700 000 000

# Social profiles (leave blank to hide the link).
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/wandcom
NEXT_PUBLIC_TIKTOK_URL=https://tiktok.com/@wandcom
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/company/wandcom

# ---------------------------------------------------------------- server ----

# Where project briefs are stored when the filesystem is writable.
# Defaults to `<project>/data/briefs`.
BRIEF_STORE_DIR=

# Optional: POST every new brief to this URL (Zapier, Make, Slack, n8n, CF Worker...).
BRIEF_WEBHOOK_URL=
# Optional: shared secret sent as the `x-wandcom-secret` header with the webhook.
BRIEF_WEBHOOK_SECRET=

# Optional: transactional email via Resend (https://resend.com).
RESEND_API_KEY=
BRIEF_FROM_EMAIL=briefs@wandcom.co.ke
BRIEF_NOTIFY_EMAIL=hello@wandcom.co.ke

# Optional: protect GET /api/brief with `Authorization: Bearer <token>`.
BRIEF_ADMIN_TOKEN=
